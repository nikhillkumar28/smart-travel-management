# ==========================================
# BACKEND ENVIRONMENT VARIABLES (Render / Railway)
# ==========================================

# Server Port (Render sets this dynamically, defaults to 3000 locally)
PORT=3000

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/express_auth?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret for authentication signing
JWT_SECRET=

# Google Gemini API Key (keep secret, never expose to frontend)
GEMINI_API_KEY=

# Optional Gemini Model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# OpenWeather API Key (keep secret, never expose to frontend)
OPENWEATHER_API_KEY=

# Allowed Frontend URL(s) for CORS protection (comma-separated if multiple)
# Example for production: https://your-travel-app.vercel.app
CLIENT_URL=
